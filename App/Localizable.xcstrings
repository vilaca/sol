    "Sol is open source under the MIT license: anyone can read the code, check these promises and help improve it.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sol é código aberto, com licença MIT: qualquer pessoa pode ler o código, confirmar estas promessas e ajudar a melhorá-lo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sol é de código aberto, sob a licença MIT: qualquer pessoa pode ler o código, conferir estas promessas e ajudar a melhorá-lo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol es de código abierto con licencia MIT: cualquiera puede leer el código, comprobar estas promesas y ayudar a mejorarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol est open source sous licence MIT : chacun peut lire le code, vérifier ces promesses et aider à l’améliorer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol ist Open Source unter der MIT-Lizenz: Jeder kann den Code lesen, diese Versprechen prüfen und mithelfen, ihn zu verbessern."
